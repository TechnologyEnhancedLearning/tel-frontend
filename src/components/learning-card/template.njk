{% from "nhsuk/components/card/macro.njk" import card %}
{% from "nhsuk/components/tag/macro.njk" import tag %}
{% from "nhsuk/components/summary-list/macro.njk" import summaryList %}
{% from "../tel-icons/certificate-icon.njk" import certificateIcon %}
{% from "../tel-rating/macro.njk" import telRating %}

{% set rawLevel = params.headingLevel | int %}
{% set headingLevel = rawLevel if (rawLevel >= 1 and rawLevel <= 7) else 2 %}
{% set hTag = "h" + headingLevel %}
{% set image = params.image if params.image else null %}
{% set courseCardClass = ' tel-learning-card--course-card' if params.isCourse else '' %}
{% set progress = null %}
{% if params.totalActivities is defined and params.totalActivities | int > 0 and params.activitiesCompleted is defined %}
  {% set progress = ((params.activitiesCompleted | float / params.totalActivities | float) * 100) | round | int %}
{% endif %}


{# Determine certificate count variable (integer, only if present and > 0) #}
{% set numberOfCertificates = params.numberOfCertificates | int if (params.numberOfCertificates is defined and params.numberOfCertificates | int > 0) else 0 %}

{# Determine if it's a course #}
{% set isCourse = true if params.isCourse or (params.type and params.type | lower == 'course') else false %}

{# Determine footer visibility conditions #}
{% set hasCatalogue = params.catalogueLinkUrl and params.catalogueLinkText %}
{% set hasDevelopedWith = params.developedWith is string and params.developedWith | trim | length > 0 %}
{% set showFooter = hasCatalogue or hasDevelopedWith %}

{% set learning_card_heading %}
  <div class="tel-learning-card__heading">
    <a href="{{ params.href | default('#') }}" class="tel-learning-card__heading-link">
      <{{ hTag }} class="tel-learning-card__heading-text">
        {{ params.heading }}
      </{{ hTag }}>
    </a>
  </div>
{% endset %}

{% set learning_card_content %}
  <div class="tel-learning-card__content">
    {% if params.description %}
      <div class="tel-learning-card__description">
        <p>{{ params.description }}</p>
      </div>
    {% endif %}

    {% if params.starRating is defined %}
      <div class="tel-learning-card__rating">
        {{ telRating({
          score: params.starRating,
          count: params.ratingCount,
          href: params.ratingHref
        }) }}
      </div>
    {% endif %}

    {% if progress is defined and progress != null %}
      <div class="tel-learning-card__key-activity-information">
        {# --- 1. NOT STARTED --- #}
        {% if progress == 0 %}

          <div class="tel-learning-card__not-started-container">
            <div class="tel-learning-card__key-info__information">
              {% set notStartedRows = [
                {
                  key: { text: "Type:" },
                  value: { text: params.type | default("Course") }
                }
              ] %}
              
              {% if params.totalActivities %}
                {% set notStartedRows = notStartedRows.concat([
                  {
                    key: { text: "Includes:" },
                    value: { text: params.totalActivities ~ " activities" }
                  }
                ]) %}
              {% endif %}

              {% if numberOfCertificates > 0 %}
                {% set certText = numberOfCertificates ~ (" certificate" if numberOfCertificates == 1 else " certificates") %}
                {% set notStartedRows = notStartedRows.concat([
                  {
                    key: { text: "With" },
                    value: { text: certText }
                  }
                ]) %}
              {% endif %}

              {{ summaryList({
                classes: "nhsuk-summary-list--no-border tel-learning-card__summary-list tel-learning-card__summary-list--compact",
                rows: notStartedRows
              }) }}
            </div>

            {% if numberOfCertificates > 0 %}
              <div class="tel-learning-card__action-icon tel-learning-card__action-icon--blue">
                {{ certificateIcon("certificate-icon--blue") }}
              </div>
            {% endif %}
          </div>

        {# --- 2. IN PROGRESS --- #}
        {% elseif progress is number and progress < 100 %}

          {% set rows = [
            {
              key: { text: "Type:" },
              value: { text: params.type | default("Course") }
            }
          ] %}

          {% if params.lastAccessed %}
            {% set rows = rows.concat([{
              key: { text: "Accessed:" },
              value: { text: params.lastAccessed }
            }]) %}
          {% endif %}

          <div class="tel-learning-card__in-progress-container">
            <div class="tel-learning-card__key-info__information">
              {{ summaryList({
                classes: "nhsuk-summary-list--no-border tel-learning-card__summary-list",
                rows: rows
              }) }}
            </div>

            <div class="tel-learning-card__key-info__status">
              {{ tag({ text: "In progress", classes: "nhsuk-tag--blue" }) }}
            </div>
          </div>

          <div class="tel-progress-bar">
            <div class="tel-progress-bar__track">
              <div class="tel-progress-bar__fill" style="width: {{ progress }}%;"></div>
            </div>
            <div class="tel-progress-bar__text">
                {{ params.activitiesCompleted }} of {{ params.totalActivities }} activities completed
            </div>
          </div>

          {% if isCourse and numberOfCertificates > 0 %}
            <div class="tel-learning-card__in-progress-certificate">
              <span class="tel-learning-card__small-cert-icon">{{ certificateIcon("certificate-icon--small") }}</span>
              <span class="tel-learning-card__small-cert-text">Includes {{ numberOfCertificates }} {% if numberOfCertificates == 1 %}certificate{% else %}certificates{% endif %}</span>
            </div>
          {% endif %}

          {% if params.totalActivities %}
            <div class="tel-learning-card__detailed-summary-wrapper">
              <div class="tel-learning-card__detailed-summary-content">
                {{ summaryList({
                  classes: "nhsuk-summary-list--no-border tel-learning-card__summary-list tel-learning-card__summary-list--compact",
                  rows: [
                    { key: { text: "Includes" }, value: { text: params.totalActivities ~ " activities" } }
                  ]
                }) }}
              </div>
            </div>
          {% endif %}

        {# --- 3. COMPLETED --- #}
        {% elseif progress == 100  %}

          {% set rows = [
            {
              key: { text: "Type:" },
              value: { text: params.type | default("Course") }
            }
          ] %}

          <div class="tel-learning-card__key-info--completed-container">
            <div class="tel-learning-card__key-info__container">
              <div class="tel-learning-card__key-info__information">
                {{ summaryList({
                  classes: "nhsuk-summary-list--no-border tel-learning-card__summary-list",
                  rows: rows
                }) }}
              </div>

              <div class="tel-learning-card__key-info__status">
                {{ tag({ text: "Completed", classes: "nhsuk-tag--green" }) }}
              </div>
            </div>

            <div class="tel-learning-card__awarded-section-wrapper">
              <div class="tel-learning-card__awarded-content">
                {% if params.awardedCertificates and params.awardedCertificates | length > 0 %}
                  {% for cert in params.awardedCertificates %}
                    <div class="tel-learning-card__awarded-item">
                      {% if cert.certificateName %}
                        <div class="tel-learning-card__certificate-name-row">
                          <span class="nhsuk-u-font-weight-bold">Name:</span> 
                          <span class="tel-learning-card__awarded-name-text">{{ cert.certificateName }}</span>
                        </div>
                      {% endif %}
                      <div class="tel-learning-card__awarded-date-row">
                        <span class="nhsuk-u-font-weight-bold">Awarded:</span> 
                        <span class="tel-learning-card__awarded-date-text">{{ cert.awardedDate }}</span>
                      </div>
                      {% if cert.certificateLink %}
                        <div class="tel-learning-card__certificate-link-row">
                          <a href="{{ cert.certificateLink }}" class="tel-learning-card__download-link">Download Certificate</a>
                        </div>
                      {% endif %}
                    </div>
                  {% endfor %}
                {% endif %}
              </div>

              {% if params.awardedCertificates and params.awardedCertificates | length > 0 %}
                <div class="tel-learning-card__action-icon tel-learning-card__action-icon--green">
                  {{ certificateIcon("certificate-icon--green") }}
                </div>
              {% endif %}
            </div>
          </div>

        {% endif %}
      </div>
    {% endif %}
  </div>

  {% if showFooter %}
    <div class="tel-learning-card__footer">
      {% if hasCatalogue %}
        <div class="tel-learning-card__catalogue">
          {% if params.catalogueImage %}
            <img src="{{ params.catalogueImage }}" alt="" class="tel-learning-card__catalogue-image">
          {% endif %}
          <a href="{{ params.catalogueLinkUrl }}" class="tel-learning-card__catalogue-link">
            {{ params.catalogueLinkText }}
          </a>
        </div>
      {% endif %}

      {% if hasDevelopedWith %}
        <div class="tel-learning-card__developed-with">
          {{ params.developedWith }}
        </div>
      {% endif %}
    </div>
  {% endif %}
{% endset %}

{% if params.showAsCard == true %}
  {% call card({
    classes: "tel-learning-card tel-learning-card--learning-card" + courseCardClass,
    image: image,
    headingHtml: learning_card_heading
  }) %}
    {{ learning_card_content | safe }}
  {%- endcall %}
{%- else %}
  <div class="tel-learning-card nhsuk-u-reading-width">
    {{ learning_card_heading | safe }}
    {{ learning_card_content | safe }}
  </div>
{%- endif %}